<RadzenTheme Theme="Material" />
<style>
    .rz-grid-table td {
        white-space: normal !important;
    }
    .rz-p-sm-12 {
        padding:0px !important;
    }
</style>
<br /><br /><br />
@if (loading == true)
{
    <p>Loading...</p>
}
else
{
    <div class="row justify-content-center">
        <h4>
            Logs&nbsp;&nbsp;
            <RadzenButton Icon="home" Click="@OnHomeClick" />
        </h4>
        <div class="row mb-1 align-items-center">
            <div class="col-12">
              <div class="row">
                <div class="col-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-p-sm-12">
                <RadzenLabel Text="Feature" Component="DropDownFeatures" />
                <RadzenDropDown @bind-Value=@Filter.Feature Data=@Features Name="DropDownFeatures" Change="@(args => OnFeatureChanged(args?.ToString()))" />
            </RadzenStack>
                    </div>
                    <div class="col-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-p-sm-12">
                <RadzenLabel Text="Level" Component="DropDownLevels" />
                <RadzenDropDown @bind-Value=@Filter.Level Data=@Levels Name="DropDownLevels" Change="@(args => OnLevelChanged(args?.ToString()))" />
            </RadzenStack>
                    </div>
                    <div class="col-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-p-sm-12">
                <RadzenLabel Text="Function" Component="DropDownFunctions" />
                <RadzenDropDown @bind-Value=@Filter.Function Data=@Functions Name="DropDownFunctions" Change="@(args => OnFunctionChanged(args?.ToString()))" />
            </RadzenStack>
                    </div>
                    <div class="col-3">
                        <RadzenButton Text="Clear Filters" Click=@ClearFilters />
                </div>
                </div>
            </div>
        </div>
    </div>

        <div class="col-12">
            <RadzenDataGrid TItem="Log" Data="_logs" @ref="Grid" Style="height:500px"
                Count="@_dataCount" IsLoading="@IsGridLoading"
                PageSizeChanged="@(async (e) => { Filter.PageSize = e; await Refresh(); })"
                PageSize="@Filter.PageSize" PageSizeOptions="@pageSizeOptions" LoadData="@LoadData"
                AllowPaging="true" AllowVirtualization="false">
                    <EmptyTemplate>
                        <p class="w-100 text-danger text-center lead">There are no Log records available.</p>
                    </EmptyTemplate>
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(Oqtane.Models.Log.LogId)" Title="LogId" />
                        <RadzenDataGridColumn Title="Date">
                            <Template Context="log">
                                @(UtcToLocal(((Log)log).LogDate).Value.ToString("g"))
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(Oqtane.Models.Log.Feature)" Title="Feature" />
                        <RadzenDataGridColumn Property="@nameof(Oqtane.Models.Log.Level)" Title="Level" />
                        <RadzenDataGridColumn Property="@nameof(Oqtane.Models.Log.Function)" Title="Function" />
                    </Columns>
                    <Template Context="data">
                        @{
                            var log = (Log)data;
                            <div class="p-3 bg-light border w-90">
                                <strong>Log Message:</strong>
                                <p>@log.Message</p>
                            </div>
                        }
                    </Template>
                    <EmptyTemplate>
                        <p style="text-align: center; color: gray;">
                            No items to display!
                        </p>
                    </EmptyTemplate>
                </RadzenDataGrid>
            </div>
}

