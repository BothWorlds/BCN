        private string GetReturnUrl()
    {
        return NavigateUrl(
            PageState.Page.Path,
            AddUrlParameters(
                Uri.EscapeDataString(Filter.Feature ?? "All Features"),
                Uri.EscapeDataString(Filter.Level ?? "All Levels"),
                Uri.EscapeDataString(Filter.Function ?? "All Functions"),
                Filter.PageSize,
                Filter.PageNumber
            ));
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (UrlParameters.ContainsKey("feature"))
            {
                Filter.Feature = Uri.UnescapeDataString(UrlParameters["feature"]);
            }
            if (UrlParameters.ContainsKey("level"))
            {
                Filter.Level = Uri.UnescapeDataString(UrlParameters["level"]);
            }
            if (UrlParameters.ContainsKey("function"))
            {
                Filter.Function = Uri.UnescapeDataString(UrlParameters["function"]);
            }
            if (UrlParameters.ContainsKey("rows"))
            {
                Filter.PageSize = int.Parse(UrlParameters["rows"]);
            }
            if (UrlParameters.ContainsKey("page") && int.TryParse(UrlParameters["page"], out int page))
            {
                Filter.PageNumber = Math.Max(0, page);
            }

            if (Grid != null)
            {
                await Refresh();
            }

            var settings = await SettingService.GetSiteSettingsAsync(PageState.Site.SiteId);
            _retention = int.Parse(SettingService.GetSetting(settings, "LogRetention", "30"));

        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Logs {Error}", ex.Message);
            AddModuleMessage(Localizer["Error.Log.Load"], MessageType.Error);
        }
    }

    protected override void OnAfterRender(bool firstRender)
