    private int _dataCount = 0;

    async Task LoadData(LoadDataArgs args)
    {
        IsGridLoading = true;
        try
        {
            var top = args.Top.GetValueOrDefault(Filter.PageSize > 0 ? Filter.PageSize : 20);
            if (top <= 0)
            {
                top = 20;
            }

            var skip = args.Skip.GetValueOrDefault(0);
            if (skip < 0)
            {
                skip = 0;
            }

            Filter.PageSize = top;
            Filter.PageNumber = skip / top;

            var siteId = SiteState?.Alias?.SiteId ?? 1;
            if (siteId <= 0)
            {
                siteId = 1;
            }

            var result = await LogService.GetLogsAsync(siteId, Filter);
            if ((result?.Total ?? 0) == 0 && siteId != 1)
            {
                result = await LogService.GetLogsAsync(1, Filter);
            }
            _logs = result?.Data ?? new List<Log>();
            _dataCount = result?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _logs = new List<Log>();
            _dataCount = 0;
            await logger.LogError(ex, "Error Loading Logs {Error}", ex.Message);
            AddModuleMessage(Localizer["Error.Log.Load"], MessageType.Error);
        }
        finally
        {
            IsGridLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
