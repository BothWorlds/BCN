@inherits Oqtane.Modules.ModuleBase
@namespace BCN.SSAHomeModule
@inject ISettingService SettingService
@inject HttpClient Http
@using System.Text.Json
@using System.Net.Http.Json
@using System.IO
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Severance Sign Art | Custom Signs in Bristol, FL</PageTitle>
<HeadContent>
    <meta name="description" content="Custom signs, lettering, decals, banners, displays, vehicle graphics, and project support from Severance Sign Art in Bristol, Florida." />
    <script id="severance-local-business" type="application/ld+json">@((MarkupString)LocalBusinessJson)</script>
</HeadContent>

<main id="main">
    <section class="hero section-pad">
        <div class="hero-copy reveal">
            <p class="eyebrow"><span>Bristol’s local sign shop</span></p>
            <h1>Make your<br><em>mark.</em></h1>
            <p class="hero-supporting">Custom signs with personality, presence, and a point of view.</p>
            <p class="hero-lede">From storefronts and vehicles to banners, lettering, and special projects—Severance Sign Art turns your idea into something people stop and notice.</p>
            <div class="hero-actions"><a class="button primary" href="/contact-us">Request a Quote</a><a class="button secondary" href="/#services">Explore Services</a></div>
            <p class="hero-contact-line"><span>Bristol, Florida · Serving Northwest Florida</span><a href="tel:+18506435712">Call 850-643-5712</a></p>
            <div class="hero-detail"><span>Custom-built</span><span>Locally crafted</span><span>Made to work</span></div>
        </div>
        <div class="hero-visual reveal" aria-label="Severance Sign Art">
            <div class="hero-rays" aria-hidden="true"></div>
            <div class="approved-logo-stage"><img src="Themes/BCN.SSATheme/images/severance-sign-art-logo-vertical-v4.png" alt="Severance Sign Art" /></div>
            <span class="hero-stamp">Made<br>local</span>
            <span class="hero-scribble" aria-hidden="true"></span>
        </div>
    </section>

    <section class="trust-bar" aria-label="Project highlights"><div><span>01</span>Custom Signs</div><div><span>02</span>Lettering & Decals</div><div><span>03</span>Banners & Displays</div><div><span>04</span>Vehicle Graphics</div><div><span>05</span>Project Support</div></section>

    <section id="about" class="section-pad split">
        <div class="reveal"><p class="eyebrow">Made for your message</p><h2>Not just a sign.<br><span class="brush-highlight">A first impression.</span></h2></div>
        <div class="content-panel reveal"><span class="panel-kicker">Big idea? Rough sketch? Start here.</span><p>Every project has a different purpose. Some signs need to guide. Some need to sell. Others need to celebrate, identify, inform, or make a place feel complete.</p><p>Severance Sign Art turns those needs into practical, visually strong sign solutions—with personal attention from the first conversation through the finished piece.</p><a class="text-link" href="/contact-us">Tell us what you’re making <span>→</span></a></div>
    </section>

    <section id="services" class="section-pad dark-panel">
        <div class="section-heading reveal"><p class="eyebrow">Capabilities</p><h2>Sign solutions for everyday business and one-of-a-kind projects.</h2><p class="lead">Tell us what the sign needs to do. We’ll help determine the right direction.</p></div>
        <div class="card-grid three service-grid">
            <a class="service-card sign-card reveal" href="custom-signs"><span class="service-number">01</span><span class="service-icon" aria-hidden="true">S</span><h3>Custom Signs</h3><p>Purpose-built signage shaped around your space, message, and audience.</p><span class="card-link">View details <b>→</b></span></a>
            <a class="service-card decal-card reveal" href="lettering-decals"><span class="service-number">02</span><span class="service-icon" aria-hidden="true">Aa</span><h3>Lettering & Decals</h3><p>Clean, effective graphics for windows, equipment, vehicles, and more.</p><span class="card-link">View details <b>→</b></span></a>
            <a class="service-card banner-card reveal" href="banners-displays"><span class="service-number">03</span><span class="service-icon" aria-hidden="true">◆</span><h3>Banners & Displays</h3><p>Flexible graphics for promotions, events, announcements, and temporary needs.</p><span class="card-link">View details <b>→</b></span></a>
            <a class="service-card vehicle-card reveal" href="vehicle-graphics"><span class="service-number">04</span><span class="service-icon" aria-hidden="true">→</span><h3>Vehicle Graphics</h3><p>Mobile identification and brand visibility that works while you do.</p><span class="card-link">View details <b>→</b></span></a>
            <a class="service-card yard-card reveal" href="yard-event-signs"><span class="service-number">05</span><span class="service-icon" aria-hidden="true">★</span><h3>Yard & Event Signs</h3><p>Readable, practical signs for campaigns, events, directions, and occasions.</p><span class="card-link">View details <b>→</b></span></a>
            <a class="service-card design-card reveal" href="design-project-support"><span class="service-number">06</span><span class="service-icon" aria-hidden="true">✦</span><h3>Design & Project Support</h3><p>Help refining artwork, choosing materials, and planning the finished piece.</p><span class="card-link">View details <b>→</b></span></a>
        </div>
    </section>

    @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
    {
        <section class="section-pad gallery-admin-panel" aria-label="Manage project photos">
            <div class="gallery-admin-heading">
                <div><p class="eyebrow">Website editor</p><h2>Add project photos</h2><p>Drop photos below or select them from your computer. They upload directly into the public gallery.</p></div>
            </div>

            <label class="gallery-dropzone @(_isUploading ? "is-uploading" : "")" for="gallery-photo-upload">
                <span class="gallery-dropzone-icon" aria-hidden="true">＋</span>
                <strong>@(_isUploading ? "Uploading your photos…" : "Drop project photos here")</strong>
                <span>@(_isUploading ? "Please keep this page open." : "or click anywhere in this box to choose files")</span>
                <small>JPG, PNG, or WebP · up to 9 photos · 12 MB each</small>
                <InputFile id="gallery-photo-upload" class="gallery-dropzone-input" OnChange="UploadPhotos" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" disabled="@_isUploading" />
            </label>

            @if (!string.IsNullOrWhiteSpace(_galleryMessage))
            {
                <p class="gallery-admin-message @(_galleryHasError ? "is-error" : "")" role="status">@_galleryMessage</p>
            }

            <div class="gallery-admin-section-fields">
                <label>Gallery heading<input @bind="_galleryHeading" /></label>
                <label>Short introduction<textarea rows="3" @bind="_galleryIntro"></textarea></label>
            </div>

            @if (_galleryItems.Count == 0)
            {
                <div class="gallery-admin-empty"><strong>No project photos yet.</strong><span>Choose up to nine JPG, PNG, or WebP images. Each photo may be up to 12 MB.</span></div>
            }
            else
            {
                <div class="gallery-admin-list">
                    @for (var index = 0; index < _galleryItems.Count; index++)
                    {
                        var item = _galleryItems[index];
                        var itemIndex = index;
                        <article class="gallery-admin-item">
                            <img src="@item.ImageUrl" alt="" />
                            <div class="gallery-admin-fields">
                                <label>Project title<input placeholder="Storefront sign" @bind="item.Title" /></label>
                                <label>Category<input placeholder="Custom Signs" @bind="item.Category" /></label>
                                <label>Image description<input placeholder="Describe the finished project" @bind="item.AltText" /></label>
                            </div>
                            <div class="gallery-admin-actions">
                                <button type="button" title="Move photo earlier" disabled="@(itemIndex == 0)" @onclick="() => MovePhoto(itemIndex, -1)">↑</button>
                                <button type="button" title="Move photo later" disabled="@(itemIndex == _galleryItems.Count - 1)" @onclick="() => MovePhoto(itemIndex, 1)">↓</button>
                                <button type="button" class="remove" @onclick="() => RemovePhoto(itemIndex)">Remove</button>
                            </div>
                        </article>
                    }
                </div>
            }

            <div class="gallery-admin-footer"><button type="button" class="button primary" disabled="@_isSaving" @onclick="SaveGallery">@(_isSaving ? "Saving…" : "Save gallery")</button><span>Changes appear immediately after saving.</span></div>
        </section>
    }

    @if (_galleryItems.Count > 0)
    {
        <section id="work" class="section-pad portfolio-section">
            <div class="portfolio-heading reveal">
                <div><p class="eyebrow">Selected work</p><h2>@_galleryHeading</h2></div>
                <div class="portfolio-heading-side">
                    <p class="lead">@_galleryIntro</p>
                    @if (_galleryItems.Count > 1)
                    {
                        <div class="portfolio-controls" aria-label="Gallery navigation">
                            <button type="button" data-gallery-scroll="previous" aria-label="Show previous project photos">←</button>
                            <button type="button" data-gallery-scroll="next" aria-label="Show next project photos">→</button>
                        </div>
                    }
                </div>
            </div>
            <div class="portfolio-grid" aria-label="Project photo gallery">
                @for (var index = 0; index < _galleryItems.Count; index++)
                {
                    var item = _galleryItems[index];
                    <figure class="portfolio-card reveal">
                        <img src="@item.ImageUrl" alt="@GalleryAlt(item)" loading="lazy" />
                        @if (!string.IsNullOrWhiteSpace(item.Title) || !string.IsNullOrWhiteSpace(item.Category))
                        {
                            <figcaption>
                                @if (!string.IsNullOrWhiteSpace(item.Category)) { <span>@item.Category</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Title)) { <strong>@item.Title</strong> }
                            </figcaption>
                        }
                    </figure>
                }
            </div>
        </section>
    }

    @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
    {
        <section class="section-pad reviews-admin-panel" aria-label="Manage customer reviews">
            <div class="gallery-admin-heading">
                <div><p class="eyebrow">Website editor</p><h2>Customer reviews</h2><p>Add only feedback you have permission to publish. This section remains hidden from visitors until a review or review-request link is saved.</p></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_reviewMessage))
            {
                <p class="gallery-admin-message @(_reviewHasError ? "is-error" : "")" role="status">@_reviewMessage</p>
            }

            <div class="review-admin-form">
                <label class="full-width">Customer quote<textarea rows="4" placeholder="Paste the customer's exact feedback" @bind="_reviewDraft.Quote"></textarea></label>
                <label>Customer name<input placeholder="Customer or business name" @bind="_reviewDraft.CustomerName" /></label>
                <label>Project type <span>(optional)</span><input placeholder="Vehicle lettering, storefront sign…" @bind="_reviewDraft.ProjectType" /></label>
                <button type="button" class="button secondary" @onclick="AddReview">Add review</button>
            </div>

            @if (_reviewItems.Count > 0)
            {
                <div class="review-admin-list">
                    @for (var index = 0; index < _reviewItems.Count; index++)
                    {
                        var review = _reviewItems[index];
                        var reviewIndex = index;
                        <article>
                            <blockquote>“@review.Quote”</blockquote>
                            <p><strong>@review.CustomerName</strong>@if (!string.IsNullOrWhiteSpace(review.ProjectType)) { <span> · @review.ProjectType</span> }</p>
                            <div class="gallery-admin-actions">
                                <button type="button" title="Move review earlier" disabled="@(reviewIndex == 0)" @onclick="() => MoveReview(reviewIndex, -1)">↑</button>
                                <button type="button" title="Move review later" disabled="@(reviewIndex == _reviewItems.Count - 1)" @onclick="() => MoveReview(reviewIndex, 1)">↓</button>
                                <button type="button" class="remove" @onclick="() => RemoveReview(reviewIndex)">Remove</button>
                            </div>
                        </article>
                    }
                </div>
            }

            <div class="review-link-field">
                <label>Google review request link <span>(optional)</span><input type="url" placeholder="Paste the direct link customers use to leave a review" @bind="_reviewRequestUrl" /></label>
                <p>When your Google Business Profile is ready, paste its “Ask for reviews” link here. A public “Leave a review” button will appear automatically.</p>
            </div>
            <div class="gallery-admin-footer"><button type="button" class="button primary" disabled="@_isSavingReviews" @onclick="SaveReviews">@(_isSavingReviews ? "Saving…" : "Save reviews")</button><span>Reviews become public only after saving.</span></div>
        </section>
    }

    @if (_reviewItems.Count > 0)
    {
        <section id="reviews" class="section-pad reviews-section">
            <div class="reviews-heading reveal">
                <div>
                    <p class="eyebrow">Customer reviews</p>
                    <h2>What customers say.</h2>
                    <p class="reviews-intro">Feedback from Severance Sign Art customers.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(SafeReviewRequestUrl))
                {
                    <div class="reviews-heading-action">
                        <span>Share your experience</span>
                        <a class="button secondary" href="@SafeReviewRequestUrl" target="_blank" rel="noopener noreferrer">Leave a Review</a>
                    </div>
                }
            </div>
            <div class="reviews-grid">
                @foreach (var review in _reviewItems)
                {
                    <article class="review-card reveal">
                        <span class="review-mark" aria-hidden="true">“</span>
                        <blockquote>@review.Quote</blockquote>
                        <footer>
                            <span class="review-initial" aria-hidden="true">@CustomerInitial(review.CustomerName)</span>
                            <p><strong>@review.CustomerName</strong>@if (!string.IsNullOrWhiteSpace(review.ProjectType)) { <span>@review.ProjectType</span> }</p>
                        </footer>
                    </article>
                }
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(SafeReviewRequestUrl))
    {
        <section id="reviews" class="review-invite-section section-pad">
            <div class="review-invite-card reveal">
                <div>
                    <p class="eyebrow">Worked with us?</p>
                    <h2>Tell others how it went.</h2>
                    <p>Your feedback helps a local sign shop grow—and helps the next customer know what to expect.</p>
                </div>
                <a class="button primary" href="@SafeReviewRequestUrl" target="_blank" rel="noopener noreferrer">Leave a Review <span aria-hidden="true">→</span></a>
            </div>
        </section>
    }

    <section id="process" class="section-pad process-section">
        <div class="section-heading reveal"><p class="eyebrow">A straightforward process</p><h2>From “what if?”<br>to “look at that.”</h2></div>
        <ol class="process-grid">
            <li class="reveal"><span>01</span><h3>Share the need</h3><p>Tell us the purpose, size, location, timing, and any artwork you already have.</p></li>
            <li class="reveal"><span>02</span><h3>Shape the solution</h3><p>We’ll discuss the design direction, materials, production needs, and next steps.</p></li>
            <li class="reveal"><span>03</span><h3>Review and approve</h3><p>Confirm the important details before the project moves into production.</p></li>
            <li class="reveal"><span>04</span><h3>Put it to work</h3><p>Receive a finished sign or graphic ready to communicate clearly.</p></li>
        </ol>
    </section>

    <section class="section-pad local-band reveal"><div><p class="eyebrow">Local work. Personal attention.</p><h2>Proudly based in Bristol, Florida.</h2></div><p>Whether you have finished artwork or only the beginning of an idea, start with a conversation.</p></section>

    <section class="section-pad"><div class="cta-band reveal"><p class="eyebrow">Have a project in mind?</p><h2>Let’s make something worth noticing.</h2><p class="lead">Share a few details about your project and Severance Sign Art can help you plan the next step.</p><div class="hero-actions centered"><a class="button primary" href="/contact-us">Request a Quote</a></div></div></section>
</main>

@code {
    private const string LocalBusinessJson = """
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "Severance Sign Art",
          "description": "Custom sign shop serving Bristol and Northwest Florida.",
          "telephone": "+1-850-643-5712",
          "email": "severancesignart@fairpoint.net",
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "10629 NW SR 20",
            "addressLocality": "Bristol",
            "addressRegion": "FL",
            "postalCode": "32321",
            "addressCountry": "US"
          },
          "areaServed": "Northwest Florida"
        }
        """;

    private string _galleryHeading = "Work made to get noticed.";
    private string _galleryIntro = "A selection of signs, lettering, displays, and custom projects made for customers across Northwest Florida.";
    private List<GalleryItem> _galleryItems = new();
    private bool _isUploading;
    private bool _isSaving;
    private bool _galleryHasError;
    private string _galleryMessage = "";
    private List<ReviewItem> _reviewItems = new();
    private ReviewItem _reviewDraft = new();
    private string _reviewRequestUrl = "";
    private string _reviewMessage = "";
    private bool _reviewHasError;
    private bool _isSavingReviews;
    private const long MaxImageBytes = 12 * 1024 * 1024;
    private int _loadedGalleryModuleId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedGalleryModuleId != ModuleState.ModuleId)
        {
            LoadGalleryFromModuleSettings();
            _loadedGalleryModuleId = ModuleState.ModuleId;
        }

        try
        {
            var response = await Http.GetAsync($"api/GalleryUpload/{ModuleState.ModuleId}?v={DateTime.UtcNow.Ticks}");
            if (response.IsSuccessStatusCode)
            {
                var gallery = await response.Content.ReadFromJsonAsync<GallerySettingsModel>();
                if (gallery != null)
                {
                    _galleryHeading = string.IsNullOrWhiteSpace(gallery.Heading) ? _galleryHeading : gallery.Heading;
                    _galleryIntro = string.IsNullOrWhiteSpace(gallery.Intro) ? _galleryIntro : gallery.Intro;
                    _galleryItems = (gallery.Items ?? new()).Where(item => !string.IsNullOrWhiteSpace(item.ImageUrl)).Take(9).ToList();
                    _reviewRequestUrl = gallery.ReviewRequestUrl ?? "";
                    _reviewItems = (gallery.Reviews ?? new()).Where(IsValidReview).Take(8).ToList();
                }
            }
            else if (_galleryItems.Count > 0 && UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                // Publish galleries created with the earlier settings-only editor.
                await SavePublicGalleryAsync();
            }
        }
        catch
        {
            // Module settings remain as a backwards-compatible fallback.
        }
    }

    private void LoadGalleryFromModuleSettings()
    {
        _galleryHeading = SettingService.GetSetting(ModuleState.Settings, "GalleryHeading", _galleryHeading);
        _galleryIntro = SettingService.GetSetting(ModuleState.Settings, "GalleryIntro", _galleryIntro);

        try
        {
            var json = SettingService.GetSetting(ModuleState.Settings, "GalleryItems", "[]");
            _galleryItems = (JsonSerializer.Deserialize<List<GalleryItem>>(json) ?? new())
                .Where(item => !string.IsNullOrWhiteSpace(item.ImageUrl))
                .Take(9)
                .ToList();
        }
        catch
        {
            _galleryItems = new();
        }

        _reviewRequestUrl = SettingService.GetSetting(ModuleState.Settings, "ReviewRequestUrl", _reviewRequestUrl);
        try
        {
            var reviewsJson = SettingService.GetSetting(ModuleState.Settings, "CustomerReviews", "[]");
            _reviewItems = (JsonSerializer.Deserialize<List<ReviewItem>>(reviewsJson) ?? new())
                .Where(IsValidReview)
                .Take(8)
                .ToList();
        }
        catch
        {
            _reviewItems = new();
        }
    }

    private static string GalleryAlt(GalleryItem item) =>
        !string.IsNullOrWhiteSpace(item.AltText) ? item.AltText :
        !string.IsNullOrWhiteSpace(item.Title) ? item.Title : "Severance Sign Art project";

    private async Task UploadPhotos(InputFileChangeEventArgs args)
    {
        var remaining = 9 - _galleryItems.Count;
        if (remaining <= 0)
        {
            ShowGalleryMessage("The gallery already contains nine photos. Remove one before adding another.", true);
            return;
        }

        _isUploading = true;
        _galleryMessage = "Uploading photos…";
        _galleryHasError = false;

        try
        {
            var files = args.GetMultipleFiles(30).Take(remaining).ToList();
            foreach (var file in files)
            {
                using var form = new MultipartFormDataContent();
                using var imageContent = new StreamContent(file.OpenReadStream(MaxImageBytes));
                imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                form.Add(imageContent, "file", file.Name);
                form.Add(new StringContent(ModuleState.ModuleId.ToString()), "moduleId");

                var url = $"api/GalleryUpload?moduleid={ModuleState.ModuleId}&authmoduleid={ModuleState.ModuleId}";
                var response = await Http.PostAsync(url, form);
                if (!response.IsSuccessStatusCode)
                {
                    var reason = await response.Content.ReadAsStringAsync();
                    throw new InvalidOperationException(string.IsNullOrWhiteSpace(reason) ? $"Could not upload {file.Name}." : reason.Trim('"'));
                }

                var upload = await response.Content.ReadFromJsonAsync<GalleryUploadResult>();
                if (upload == null || string.IsNullOrWhiteSpace(upload.Url)) throw new InvalidOperationException($"Could not upload {file.Name}.");

                _galleryItems.Add(new GalleryItem
                {
                    ImageUrl = upload.Url,
                    Title = Path.GetFileNameWithoutExtension(file.Name).Replace('-', ' ').Replace('_', ' '),
                    AltText = ""
                });
            }

            await SaveGallerySettings();
            ShowGalleryMessage($"Added {files.Count} photo{(files.Count == 1 ? "" : "s")}. Add the project details below, then save the gallery.");
        }
        catch (Exception ex)
        {
            ShowGalleryMessage(ex.Message, true);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task SaveGallery()
    {
        _isSaving = true;
        try
        {
            await SaveGallerySettings();
            ShowGalleryMessage("Gallery saved.");
        }
        catch (Exception ex)
        {
            ShowGalleryMessage(ex.Message, true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveGallerySettings()
    {
        await SavePublicGalleryAsync();

        var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
        settings = SettingService.SetSetting(settings, "GalleryHeading", _galleryHeading.Trim());
        settings = SettingService.SetSetting(settings, "GalleryIntro", _galleryIntro.Trim());
        settings = SettingService.SetSetting(settings, "GalleryItems", JsonSerializer.Serialize(_galleryItems.Take(9).ToList()));
        settings = SettingService.SetSetting(settings, "ReviewRequestUrl", SafeReviewRequestUrl);
        settings = SettingService.SetSetting(settings, "CustomerReviews", JsonSerializer.Serialize(_reviewItems.Where(IsValidReview).Take(8).ToList()));
        await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
    }

    private async Task SavePublicGalleryAsync()
    {
        var gallery = new GallerySettingsModel
        {
            Heading = _galleryHeading.Trim(),
            Intro = _galleryIntro.Trim(),
            Items = _galleryItems.Where(item => !string.IsNullOrWhiteSpace(item.ImageUrl)).Take(9).ToList(),
            ReviewRequestUrl = SafeReviewRequestUrl,
            Reviews = _reviewItems.Where(IsValidReview).Take(8).ToList()
        };
        var url = $"api/GalleryUpload/{ModuleState.ModuleId}?moduleid={ModuleState.ModuleId}&authmoduleid={ModuleState.ModuleId}";
        var response = await Http.PutAsJsonAsync(url, gallery);
        if (!response.IsSuccessStatusCode)
        {
            var reason = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(reason) ? "The public gallery could not be saved." : reason.Trim('"'));
        }
    }

    private void MovePhoto(int index, int direction)
    {
        var target = index + direction;
        if (index < 0 || index >= _galleryItems.Count || target < 0 || target >= _galleryItems.Count) return;
        (_galleryItems[index], _galleryItems[target]) = (_galleryItems[target], _galleryItems[index]);
        ShowGalleryMessage("Order changed. Select Save gallery when you’re finished.");
    }

    private void RemovePhoto(int index)
    {
        if (index < 0 || index >= _galleryItems.Count) return;
        _galleryItems.RemoveAt(index);
        ShowGalleryMessage("Photo removed from the gallery. Select Save gallery to confirm.");
    }

    private void ShowGalleryMessage(string message, bool isError = false)
    {
        _galleryMessage = message;
        _galleryHasError = isError;
    }

    private string SafeReviewRequestUrl
    {
        get
        {
            var value = (_reviewRequestUrl ?? "").Trim();
            return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
                (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
                ? uri.AbsoluteUri
                : "";
        }
    }

    private static bool IsValidReview(ReviewItem review) =>
        review != null && !string.IsNullOrWhiteSpace(review.Quote) && !string.IsNullOrWhiteSpace(review.CustomerName);

    private static string CustomerInitial(string customerName)
    {
        var name = (customerName ?? string.Empty).Trim();
        return name.Length == 0 ? "S" : name[..1].ToUpperInvariant();
    }

    private void AddReview()
    {
        if (!IsValidReview(_reviewDraft))
        {
            ShowReviewMessage("Add both the customer quote and customer name.", true);
            return;
        }
        if (_reviewItems.Count >= 8)
        {
            ShowReviewMessage("The page can display up to eight reviews. Remove one before adding another.", true);
            return;
        }

        _reviewItems.Add(new ReviewItem
        {
            Quote = _reviewDraft.Quote.Trim(),
            CustomerName = _reviewDraft.CustomerName.Trim(),
            ProjectType = (_reviewDraft.ProjectType ?? "").Trim()
        });
        _reviewDraft = new ReviewItem();
        ShowReviewMessage("Review added. Select Save reviews when you’re finished.");
    }

    private void MoveReview(int index, int direction)
    {
        var target = index + direction;
        if (index < 0 || index >= _reviewItems.Count || target < 0 || target >= _reviewItems.Count) return;
        (_reviewItems[index], _reviewItems[target]) = (_reviewItems[target], _reviewItems[index]);
        ShowReviewMessage("Order changed. Select Save reviews when you’re finished.");
    }

    private void RemoveReview(int index)
    {
        if (index < 0 || index >= _reviewItems.Count) return;
        _reviewItems.RemoveAt(index);
        ShowReviewMessage("Review removed. Select Save reviews to confirm.");
    }

    private async Task SaveReviews()
    {
        if (!string.IsNullOrWhiteSpace(_reviewRequestUrl) && string.IsNullOrWhiteSpace(SafeReviewRequestUrl))
        {
            ShowReviewMessage("Enter a complete review link beginning with https://, or leave it blank for now.", true);
            return;
        }

        _isSavingReviews = true;
        try
        {
            await SaveGallerySettings();
            ShowReviewMessage("Reviews saved.");
        }
        catch (Exception ex)
        {
            ShowReviewMessage(ex.Message, true);
        }
        finally
        {
            _isSavingReviews = false;
        }
    }

    private void ShowReviewMessage(string message, bool isError = false)
    {
        _reviewMessage = message;
        _reviewHasError = isError;
    }
}
