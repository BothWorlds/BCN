@using Microsoft.AspNetCore.Authorization
@using Oqtane.Services
@using System.Security.Claims

@inherits Oqtane.Modules.ModuleBase
@namespace BCN.WebManagedItModule

<div class="row justify-content-center">
    <div class="col-12">
        
        <main id="main">

            <section class="section-pad service-hero">
                <div class="reveal">
                    <p class="eyebrow">Service</p>
                    <h1>Managed IT Services</h1>
                    <p class="hero-supporting">Keeping your business productive with proactive support, monitoring, maintenance, and strategic technology management.</p>
                    <div class="hero-actions"><a class="button primary" href="contact-us">Start a Conversation</a><a class="button secondary" href="managed-it#service-details">See Coverage</a></div>
                </div>
                <div class="service-symbol reveal" aria-hidden="true"><span class="circuit-line circuit-line-a"></span><span class="circuit-line circuit-line-b"></span><span class="circuit-line circuit-line-c"></span><span class="signal-dot signal-dot-a"></span><span class="signal-dot signal-dot-b"></span><span class="signal-dot signal-dot-c"></span><span class="scanner-beam"></span><span class="cat-platform"></span><img class="service-cat-image" src="themes/BCN.MyTheme/assets/bc-logo-without-background.png" alt=""></div>
            </section>
            <section class="section-pad service-layout">
                <article id="service-details" class="service-main-panel reveal">
                    <h2>What this service covers</h2>
                    <p>Black Cat Networks becomes your outsourced IT department, providing responsive support backed by proactive maintenance and long-term planning.</p>
                    <p>The goal is to prevent problems before they interrupt your business while helping leadership make informed technology decisions.</p>
                    <h2>Key services</h2>
                    <ul><li>Help desk and user support</li><li>Proactive monitoring</li><li>Patch management</li><li>Asset and lifecycle management</li><li>Vendor management</li><li>Technology planning</li><li>IT budget consulting</li><li>Secure remote access support</li></ul>
                    <div class="hero-actions"><a class="button primary" href="contact-us">Start a Conversation</a><a class="button secondary" href="/#services">Back to Services</a></div>
                </article>
                <aside class="service-nav-panel reveal">
                    <p class="eyebrow">Other Services</p>
                    <div class="service-list"><a class="active" href="managed-it">Managed IT Services</a><a href="cybersecurity">Cybersecurity</a><a href="network-support">Network Infrastructure</a><a href="cloud-services">Microsoft & Cloud Services</a><a href="backup-recovery">Business Continuity</a><a href="compliance-risk">Compliance & Risk</a><a href="strategic-it-consulting">Strategic Consulting</a></div>
                    <a class="button secondary full" href="/">Back to Main Page</a>
                </aside>
            </section>
        </main>
    </div>
</div>
